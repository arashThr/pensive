{{template "header" .}}

<div class="page-narrow">
  <div class="mx-auto max-w-xl">
    <h1 class="headline text-ink">Add to your library</h1>
    <p class="lede mt-1">Paste a link and Pensive keeps the full text, searchable forever.</p>

    <form action="/bookmarks" method="post" class="card-raised mt-8 p-6">
      <label class="label" for="link">Web page URL</label>
      <input class="input" name="link" id="link" type="url" placeholder="https://example.com/article" required autofocus value="{{.Link}}" />
      <button class="btn btn-primary mt-5 w-full" type="submit">Save to library</button>
    </form>

    <h2 class="eyebrow mt-12 mb-4 text-ink-faint">Save faster next time</h2>
    <div class="grid gap-3 sm:grid-cols-2">
      <a href="/integrations" class="card-link flex items-start gap-4 p-5">
        <img src="/assets/icons/chrome.svg" alt="" class="size-8" />
        <div>
          <p class="title">Browser extension</p>
          <p class="mt-0.5 text-sm text-ink-muted">Save any page in one click.</p>
        </div>
      </a>
      <a href="/integrations" class="card-link flex items-start gap-4 p-5">
        <img src="/assets/icons/telegram.svg" alt="" class="size-8" />
        <div>
          <p class="title">Telegram bot</p>
          <p class="mt-0.5 text-sm text-ink-muted">Forward links from your phone.</p>
        </div>
      </a>
    </div>
  </div>
</div>

{{template "footer" .}}
