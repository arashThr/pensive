{{template "header" .}}

<!-- Load marked.js for markdown rendering -->
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<article class="page-narrow">
  <a href="/home" class="btn btn-sm btn-ghost -ml-3 mb-6">
    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
    </svg>
    Library
  </a>

  <!-- Header -->
  <header class="flex items-start gap-4">
    <div class="min-w-0 flex-1">
      <div class="meta mb-3">
        <span class="flex size-6 items-center justify-center rounded-md bg-surface-strong">
          <img src="https://www.google.com/s2/favicons?domain={{.Link}}&sz=64" alt="" class="size-4 rounded-sm" onerror="this.remove()" />
        </span>
        <span class="text-ink-muted">{{.Host}}</span>
        <span aria-hidden="true">·</span>
        <span>Saved {{.CreatedAt.Format "Jan 2, 2006"}}</span>
      </div>
      <h1 class="headline wrap-break-word text-ink">{{.Title}}</h1>
      <a href="{{.Link}}" target="_blank" rel="noopener"
        class="mt-3 inline-flex max-w-full items-center gap-1.5 text-sm font-medium text-accent hover:underline">
        <span class="truncate">{{.Link}}</span>
        <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>

    {{if .Thumbnail}}
    <a href="{{.Link}}" target="_blank" rel="noopener" class="hidden shrink-0 sm:block">
      <img src="{{.Thumbnail}}" alt="" class="size-24 rounded-xl border border-line object-cover" />
    </a>
    {{end}}

    <!-- Actions Menu -->
    <div class="relative shrink-0">
      <button id="propertiesMenuButton" class="btn-icon" aria-label="Bookmark actions">
        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
          <path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z" />
        </svg>
      </button>
      <div id="propertiesMenu" class="menu hidden">
        <button id="toggleMarkdownBtn" class="menu-item">
          <span id="markdownBtnText">View markdown</span>
        </button>
        <a href="/bookmarks/{{.Id}}/markdown" class="menu-item">Open markdown page</a>
        <button id="reportBtn" class="menu-item">Report issue</button>
        <hr class="my-1 border-line">
        <form action="/bookmarks/{{.Id}}/delete" method="post"
          onsubmit="return confirm('Are you sure you want to delete this bookmark?');">
          {{csrfField}}
          <button type="submit" class="menu-item text-danger hover:bg-danger-wash hover:text-danger">Delete bookmark</button>
        </form>
      </div>
    </div>
  </header>

  <div class="mt-10 space-y-10">
    <!-- Opening paragraph -->
    <section>
      <h2 class="eyebrow mb-3 text-ink-faint">Opening paragraph</h2>
      <div class="prose-archive">
        {{if .AIExcerpt}}{{safeHTML .AIExcerpt}}{{else}}{{safeHTML .Excerpt}}{{end}}
      </div>
    </section>

    {{if .AISummary}}
    <section class="ai-panel">
      <div class="mb-3 flex items-center gap-2">
        <svg class="h-5 w-5 text-notice" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2l1.9 5.6L19.5 9.5l-5.6 1.9L12 17l-1.9-5.6L4.5 9.5l5.6-1.9L12 2zm7 11l.95 2.55L22.5 16.5l-2.55.95L19 20l-.95-2.55L15.5 16.5l2.55-.95L19 13z"/>
        </svg>
        <h2 class="font-display text-xl font-semibold text-ink">Key insights</h2>
      </div>
      <div id="aiSummaryContent" class="prose-archive prose-compact"></div>
      <script>document.getElementById('aiSummaryContent').innerHTML = marked.parse({{.AISummary}});</script>
    </section>
    {{end}}

    {{if .AITags}}
    <section>
      <h2 class="eyebrow mb-3 text-ink-faint">Topics</h2>
      <div class="flex flex-wrap gap-2">
        {{range split .AITags ","}}
        <span class="chip">{{trim .}}</span>
        {{end}}
      </div>
    </section>
    {{end}}

    <!-- Markdown (hidden until requested) -->
    <section id="markdownContainer" class="card-raised hidden p-6 sm:p-8">
      <div class="mb-6 flex items-center justify-between gap-4">
        <h2 class="eyebrow text-ink-faint">Captured content</h2>
        <button id="hideMarkdownBtn" class="btn btn-sm btn-ghost">Hide</button>
      </div>
      <div id="markdownContent" class="prose-archive"
        hx-get="/bookmarks/{{.Id}}/markdown-content" hx-trigger="load once"
        hx-on:htmx:after-request="if(event.detail.xhr.status === 200) { this.innerHTML = marked.parse(event.detail.xhr.responseText); }">
        <div class="flex items-center justify-center gap-3 py-8 text-ink-muted">
          <span class="spinner"></span>
          Loading content…
        </div>
      </div>
    </section>
  </div>
</article>

<!-- Report Modal -->
<div id="reportModal" class="modal-backdrop">
  <div class="modal">
    <h3 class="headline-md text-ink">Report a capture issue</h3>
    <p class="mt-3 mb-6 text-ink-muted">
      If this page wasn't captured properly, let us know. We'll look into why and make it better.
    </p>
    <div id="reportStatus" class="mb-4 hidden"></div>
    <div class="flex justify-end gap-3">
      <button id="cancelReportBtn" class="btn btn-secondary">Cancel</button>
      <button id="submitReportBtn" class="btn btn-primary"
        hx-post="/bookmarks/{{.Id}}/report"
        hx-target="#reportStatus"
        hx-vals='{"gorilla.csrf.Token": "{{csrfToken}}"}'
        hx-on:htmx:after-request="handleReportResponse(event)">
        Send report
      </button>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const menuButton = document.getElementById('propertiesMenuButton');
    const menu = document.getElementById('propertiesMenu');
    menuButton.addEventListener('click', function (e) {
      e.stopPropagation();
      menu.classList.toggle('hidden');
    });
    menu.addEventListener('click', (e) => e.stopPropagation());
    document.addEventListener('click', () => menu.classList.add('hidden'));

    // Report modal
    const reportModal = document.getElementById('reportModal');
    const reportStatus = document.getElementById('reportStatus');
    const setModal = (open) => {
      reportModal.classList.toggle('hidden', !open);
      reportModal.classList.toggle('flex', open);
      if (!open) {
        reportStatus.classList.add('hidden');
        reportStatus.innerHTML = '';
      }
    };
    document.getElementById('reportBtn').addEventListener('click', () => {
      menu.classList.add('hidden');
      setModal(true);
    });
    document.getElementById('cancelReportBtn').addEventListener('click', () => setModal(false));
    reportModal.addEventListener('click', (e) => { if (e.target === reportModal) setModal(false); });

    window.handleReportResponse = function (event) {
      reportStatus.classList.remove('hidden');
      if (event.detail.xhr.status === 200) {
        reportStatus.innerHTML = '<div class="callout callout-ok">Report sent. Thank you for helping us improve.</div>';
        setTimeout(() => setModal(false), 2000);
      } else {
        reportStatus.innerHTML = '<div class="callout callout-danger">Failed to send report. Please try again.</div>';
      }
    };

    // Markdown toggle
    const markdownContainer = document.getElementById('markdownContainer');
    const markdownBtnText = document.getElementById('markdownBtnText');
    const setMarkdown = (visible) => {
      markdownContainer.classList.toggle('hidden', !visible);
      markdownBtnText.textContent = visible ? 'Hide markdown' : 'View markdown';
      if (visible) markdownContainer.scrollIntoView({behavior: 'smooth', block: 'start'});
    };
    document.getElementById('toggleMarkdownBtn').addEventListener('click', () => {
      menu.classList.add('hidden');
      setMarkdown(markdownContainer.classList.contains('hidden'));
    });
    document.getElementById('hideMarkdownBtn').addEventListener('click', () => setMarkdown(false));
  });
</script>

{{template "footer" .}}
