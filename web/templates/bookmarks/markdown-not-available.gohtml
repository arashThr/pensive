{{template "header" .}}

<div class="page-narrow">
  <div class="card mx-auto max-w-xl p-8 text-center">
    <div class="icon-tile mx-auto mb-5 size-14 rounded-2xl">
      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
      </svg>
    </div>
    <h1 class="headline-md text-ink">Markdown isn't ready</h1>
    <p class="mt-2 text-ink-muted">There's no markdown version of this bookmark yet.</p>

    <ul class="mt-6 space-y-2 rounded-xl border border-line bg-paper p-5 text-left text-sm text-ink-muted">
      <li><strong class="text-ink">Still processing</strong> — the AI is still working on it.</li>
      <li><strong class="text-ink">Imported</strong> — imported items don't get AI summaries.</li>
      <li><strong class="text-ink">Processing failed</strong> — the content couldn't be converted.</li>
    </ul>

    <div class="mt-7 flex flex-col justify-center gap-3 sm:flex-row">
      <a href="/bookmarks/{{.Id}}" class="btn btn-primary">Back to bookmark</a>
      <a href="/home" class="btn btn-secondary">Go to library</a>
    </div>
  </div>
</div>

{{template "footer" .}}
