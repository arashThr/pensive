{{template "header" .}}

<article class="page-narrow">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <a href="/bookmarks/{{.Id}}" class="btn btn-sm btn-ghost -ml-3">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Back to bookmark
    </a>
    <a href="/bookmarks/{{.Id}}/full" class="btn btn-sm btn-secondary">View raw text</a>
  </div>

  <header class="mb-10 border-b border-line pb-8">
    <h1 class="display wrap-break-word text-ink">{{.Title}}</h1>
    <a href="{{.Link}}" target="_blank" rel="noopener" class="mt-4 block truncate text-sm font-medium text-clay hover:underline">{{.Link}}</a>
  </header>

  <div id="markdown-content" class="prose-archive"></div>
</article>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script>
  document.getElementById('markdown-content').innerHTML = marked.parse({{.MarkdownContent}});
</script>

{{template "footer" .}}
