{{template "header" .}}

<article class="page-narrow">
  <a href="/feeds" onclick="if (history.length > 1) { history.back(); return false; }" class="btn btn-sm btn-ghost -ml-3 mb-6">
    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
    </svg>
    Back
  </a>

  <header>
    <div class="meta mb-3">
      <span class="flex size-6 items-center justify-center rounded-md bg-surface-strong">
        <img src="https://www.google.com/s2/favicons?domain={{.URL}}&sz=64" alt="" class="size-4 rounded-sm" onerror="this.remove()" />
      </span>
      <span class="text-ink-muted">{{.FeedTitle}}</span>
      {{if .Author}}<span aria-hidden="true">·</span><span>{{.Author}}</span>{{end}}
      <span aria-hidden="true">·</span>
      <span>{{.PublishedAt.Format "Jan 2, 2006"}}</span>
    </div>
    <h1 class="headline wrap-break-word text-ink">{{.Title}}</h1>
    <div class="mt-5 flex flex-wrap items-center gap-2">
      {{template "feed-save" .}}
      <a href="{{.URL}}" target="_blank" rel="noopener" class="btn btn-sm btn-ghost">
        Open original
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
      </a>
    </div>
  </header>

  <div class="prose-archive mt-10 border-t border-line pt-8">
    {{if .HTML}}
      {{.HTML}}
    {{else if .Content}}
      <p>{{.Content}}</p>
    {{else}}
      <p class="text-ink-faint">This feed only shares the title.</p>
    {{end}}
  </div>

  <div class="callout callout-info mt-12">
    <p>
      This is what <strong class="text-ink">{{.FeedTitle}}</strong> publishes in its feed, which may be only part of the post.
      <a href="{{.URL}}" target="_blank" rel="noopener" class="link">Read it on the original site</a>, or save it to keep the full page searchable in your library.
    </p>
  </div>
</article>

{{template "footer" .}}
