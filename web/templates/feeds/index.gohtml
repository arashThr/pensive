{{template "header" .}}

<div class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
  <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_18rem] lg:gap-10">

    <!-- Sidebar: feeds and the rarely used add/sync actions -->
    <aside class="mb-8 lg:order-2 lg:mb-0">
      <div class="space-y-4 lg:sticky lg:top-24">
        {{if .Subscriptions}}
          <details class="card lg:hidden">
            <summary class="cursor-pointer px-4 py-3 text-sm font-semibold text-ink">Your feeds · {{len .Subscriptions}}</summary>
            <div class="border-t border-line p-2">{{template "feed-list" .}}</div>
          </details>
          <nav class="card hidden p-2 lg:block" aria-label="Your feeds">
            <p class="eyebrow px-2.5 pt-1.5 pb-2 text-ink-faint">Your feeds · {{len .Subscriptions}}</p>
            {{template "feed-list" .}}
          </nav>
        {{end}}

        <details class="card" {{if not .Subscriptions}}open{{end}}>
          <summary class="cursor-pointer px-4 py-3 text-sm font-semibold text-ink">Add feeds</summary>
          <div class="space-y-5 border-t border-line p-4">
            <form action="/feeds" method="post">
              <label class="label" for="feed-url">Follow a feed or blog</label>
              <input class="input text-sm" id="feed-url" name="url" type="url" placeholder="https://example.com/blog" required />
              <button type="submit" class="btn btn-sm btn-primary mt-2 w-full">Follow</button>
            </form>
            <form action="/feeds/import" method="post" enctype="multipart/form-data">
              <label class="label" for="opml-file">Sync from your reader (OPML)</label>
              <input id="opml-file" type="file" name="opml" accept=".opml,.xml,text/xml,text/x-opml" required
                class="input cursor-pointer py-1.5 text-xs file:mr-2 file:cursor-pointer file:rounded-md file:border-0 file:bg-surface-strong file:px-2 file:py-1 file:text-xs file:font-semibold file:text-ink">
              <button type="submit" class="btn btn-sm btn-secondary mt-2 w-full">Sync OPML</button>
              <p class="mt-2 text-xs text-ink-faint">Re-upload any time. New feeds are added; feeds missing from the file stop updating, and their posts stay searchable.</p>
            </form>
            {{if .Subscriptions}}
              <a href="/feeds/export" class="block text-center text-xs font-medium text-ink-muted hover:text-accent">Export OPML</a>
            {{end}}
          </div>
        </details>
      </div>
    </aside>

    <!-- Main: posts -->
    <section class="min-w-0 lg:order-1">
      {{if .Feed}}
        <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
          <div class="min-w-0">
            <a href="/feeds" class="mb-1 inline-block text-[13px] font-medium text-ink-faint hover:text-accent">← All feeds</a>
            <h1 class="headline-md wrap-break-word text-ink">{{.Feed.Title}}</h1>
            <p class="mt-1 truncate font-mono text-xs text-ink-faint">{{.Feed.URL}} · {{.Feed.EntryCount}} posts</p>
            {{if ge .Feed.ErrorCount 3}}<p class="mt-2 text-sm text-danger">This feed is failing to update: {{.Feed.LastError}}</p>{{end}}
          </div>
          <form action="/feeds/{{.Feed.FeedID}}/unsubscribe" method="post" onsubmit="return confirm('Stop following this feed? Posts already collected stay searchable.');">
            <button type="submit" class="btn btn-sm btn-secondary">Unfollow</button>
          </form>
        </div>
      {{else}}
        <div class="mb-6">
          <h1 class="headline-md text-ink">Feeds</h1>
          {{if .Subscriptions}}
            <p class="mt-1 font-mono text-xs text-ink-faint">
              {{.Stats.Posts}} posts from {{.Stats.Feeds}} feeds{{if .Stats.Since}} · collecting since {{.Stats.Since.Format "Jan 2, 2006"}}{{end}}
            </p>
            <p class="mt-1 text-[13px] text-ink-faint">Search them from your library with <strong class="font-semibold text-ink-muted">Everything</strong>. Feeds only include recent posts, so this archive grows from the day you follow them.</p>
          {{end}}
        </div>
      {{end}}

      {{if .Recent}}
        <ul class="card divide-y divide-line overflow-hidden">
          {{range .Recent}}
            {{template "feed-row" .}}
          {{end}}
        </ul>
        {{if or (gt .Page 1) .HasMore}}
        <div class="mt-6 grid grid-cols-2">
          <div>{{if gt .Page 1}}<a href="/feeds?{{.PageParams}}page={{.PrevPage}}" class="btn btn-sm btn-secondary">← Newer</a>{{end}}</div>
          <div class="text-right">{{if .HasMore}}<a href="/feeds?{{.PageParams}}page={{.NextPage}}" class="btn btn-sm btn-secondary">Older →</a>{{end}}</div>
        </div>
        {{end}}
      {{else if .Subscriptions}}
        <div class="callout callout-info">
          <span class="spinner size-4 shrink-0"></span>
          <p>Fetching posts. They'll appear here within a few minutes.</p>
        </div>
      {{else}}
        <div class="card px-6 py-12 text-center">
          <h2 class="title">Follow the people you read</h2>
          <p class="mx-auto mt-2 max-w-md text-ink-muted">
            Add blogs or sync your reader's OPML export. Their posts become searchable next to your library, so you can find what they wrote about any topic.
          </p>
        </div>
      {{end}}
    </section>
  </div>
</div>

{{template "footer" .}}

{{define "feed-list"}}
<ul class="max-h-[60vh] space-y-0.5 overflow-y-auto">
  <li><a href="/feeds" class="nav-item py-1.5" {{if not .Feed}}aria-current="page"{{end}}>All posts</a></li>
  {{$current := .Feed}}
  {{range .Subscriptions}}
  <li>
    <a href="/feeds?feed={{.FeedID}}" class="nav-item flex items-center gap-2 py-1.5" {{if and $current (eq $current.FeedID .FeedID)}}aria-current="page"{{end}} title="{{.URL}}">
      <span class="min-w-0 flex-1 truncate">{{.Title}}</span>
      {{if ge .ErrorCount 3}}
        <span class="size-2 shrink-0 rounded-full bg-danger" title="Failing: {{.LastError}}"></span>
      {{else}}
        <span class="shrink-0 font-mono text-[11px] text-ink-faint">{{.EntryCount}}</span>
      {{end}}
    </a>
  </li>
  {{end}}
</ul>
{{end}}
