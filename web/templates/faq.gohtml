{{template "header" .}}

<div class="page-narrow">
  <div class="mb-10">
    <h1 class="headline text-ink">Frequently asked questions</h1>
    <p class="lede mt-1">Everything you need to know about keeping your library in Pensive.</p>
  </div>

  {{if .Questions}}
    <div class="divide-y divide-line border-y border-line">
      {{range .Questions}}
        {{template "qa" .}}
      {{end}}
    </div>
  {{else}}
    <div class="card p-8 text-center">
      <h3 class="title">No FAQs yet</h3>
      <p class="mt-1 text-ink-muted">We're working on answers to common questions.</p>
    </div>
  {{end}}

  <div class="card mt-12 p-8 text-center">
    <h3 class="headline-md text-ink">Still curious?</h3>
    <p class="mt-1 mb-6 text-ink-muted">I'm happy to help with any question about Pensive.</p>
    <a href="/contact" class="btn btn-primary">Get in touch</a>
  </div>
</div>

{{template "footer" .}}

{{define "qa"}}
<details class="group py-5">
  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-serif text-xl font-semibold text-ink [&::-webkit-details-marker]:hidden">
    {{.Question}}
    <svg class="h-5 w-5 shrink-0 text-ink-faint transition-transform group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
    </svg>
  </summary>
  <p class="mt-3 max-w-[65ch] text-ink-muted">{{.Answer}}</p>
</details>
{{end}}
