{{template "header" .}}

<div class="page-narrow">
  <div class="mx-auto max-w-2xl text-center">
    <img src="/assets/promo/me.jpg" alt="Arash" class="mx-auto mb-6 size-24 rounded-full border-4 border-paper object-cover shadow-lift">
    <h1 class="headline text-ink">Get in touch</h1>
    <p class="lede mt-2">Questions, feedback, or ideas? I'd love to hear from you, and I usually reply within a few hours.</p>
  </div>

  <div class="mx-auto mt-10 grid max-w-2xl gap-3 sm:grid-cols-2">
    <a href="mailto:arash.thr@live.com" class="card-link flex items-center gap-4 p-5">
      <span class="icon-tile">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
      </span>
      <span class="min-w-0">
        <span class="eyebrow block text-ink-faint">Email</span>
        <span class="block truncate font-medium text-ink">arashThr@duck.com</span>
      </span>
    </a>
    <a href="https://t.me/+ptByqyNGA8Q1ZTA0" target="_blank" rel="noopener" class="card-link flex items-center gap-4 p-5">
      <span class="icon-tile">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
      </span>
      <span class="min-w-0">
        <span class="eyebrow block text-ink-faint">Telegram</span>
        <span class="block truncate font-medium text-ink">Pensive support group</span>
      </span>
    </a>
    <a href="https://arashtaher.com" target="_blank" rel="noopener" class="card-link flex items-center gap-4 p-5">
      <span class="icon-tile">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9V3m0 18a9 9 0 01-9-9m9-9a9 9 0 00-9 9" /></svg>
      </span>
      <span class="min-w-0">
        <span class="eyebrow block text-ink-faint">Website</span>
        <span class="block truncate font-medium text-ink">arashtaher.com</span>
      </span>
    </a>
    <a href="https://twitter.com/rshthr" target="_blank" rel="noopener" class="card-link flex items-center gap-4 p-5">
      <span class="icon-tile">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" /></svg>
      </span>
      <span class="min-w-0">
        <span class="eyebrow block text-ink-faint">Twitter</span>
        <span class="block truncate font-medium text-ink">@rshthr</span>
      </span>
    </a>
  </div>
</div>

{{template "footer" .}}
