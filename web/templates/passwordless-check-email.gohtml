{{template "header" .}}

<div class="page-auth">
  <div class="card-raised p-6 text-center sm:p-8">
    <div class="icon-tile mx-auto mb-5 size-14 rounded-2xl text-accent">
      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
      </svg>
    </div>
    <h1 class="headline-md text-ink">Check your email</h1>
    <p class="mt-2 text-ink-muted">
      We've sent a magic link to <span class="font-semibold text-ink">{{.Email}}</span>.
      Click it to {{if eq .Type "signup"}}finish signing up{{else}}sign in{{end}}.
    </p>

    <div class="mt-6 rounded-xl border border-line bg-surface p-4 text-left text-sm text-ink-muted">
      <p class="mb-1 font-semibold text-ink">Didn't get it?</p>
      <ul class="list-inside list-disc space-y-1">
        <li>Check your spam folder</li>
        <li>Make sure the email address is correct</li>
        <li>
          <a href="{{if eq .Type "signup"}}/auth/passwordless/signup{{else}}/auth/passwordless/signin{{end}}" class="link">Try again</a>
          or <a href="/contact" class="link">contact support</a>
        </li>
      </ul>
    </div>

    {{if eq .Type "signup"}}
    <a href="/auth/passwordless/signin" class="btn btn-ghost mt-6">Already have an account?</a>
    {{else}}
    <a href="/auth/passwordless/signup" class="btn btn-ghost mt-6">Need an account?</a>
    {{end}}
  </div>
</div>

{{template "footer" .}}
