{{template "header" .}}

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<div class="page-auth">
  <div class="card-raised p-6 sm:p-8">
    <h1 class="headline-md mb-1 text-center text-ink">Start your library</h1>
    <p class="mb-7 text-center text-sm text-ink-muted">We'll email you a link to finish signing up.</p>

    {{template "beta-notice"}}
    {{template "oauth-buttons"}}

    <div class="divider my-6">or get a magic link</div>

    <form action="/auth/passwordless/signup" method="post" class="space-y-4">
      {{csrfField}}
      <div>
        <label class="label" for="email">Email address</label>
        <input class="input" name="email" id="email" type="email" placeholder="you@example.com" required autocomplete="email" />
      </div>
      <div class="flex justify-center">
        <div class="cf-turnstile" data-size="flexible" data-theme="light" data-sitekey="{{.TurnstileSiteKey}}"></div>
      </div>
      <button class="btn btn-primary w-full" type="submit">Send magic link</button>
    </form>

    <div class="mt-6 flex justify-between text-sm">
      <a class="text-ink-muted hover:text-accent" href="/auth/passwordless/signin">Already have an account?</a>
      <a class="text-ink-muted hover:text-accent" href="/signup">Use a password</a>
    </div>
  </div>
</div>

{{template "footer" .}}
