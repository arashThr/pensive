{{template "header" .}}

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<div class="page-auth">
  <div class="card-raised p-6 sm:p-8">
    <h1 class="headline-md mb-1 text-center text-ink">Start your library</h1>
    <p class="mb-7 text-center text-sm text-ink-muted">Save what you read. Find it again, word for word.</p>

    {{template "beta-notice"}}
    {{template "oauth-buttons"}}

    <div class="divider my-6">or sign up with email</div>

    <form action="/users" method="post" class="space-y-4">
      {{csrfField}}
      <div>
        <label class="label" for="email">Email address</label>
        <input class="input" name="email" id="email" type="email" placeholder="you@example.com" required autocomplete="email" />
      </div>
      <div>
        <label class="label" for="password">Password</label>
        <input class="input" name="password" id="password" type="password" placeholder="Create a password" required autocomplete="new-password" />
      </div>
      <div class="flex justify-center">
        <div class="cf-turnstile" data-size="flexible" data-theme="light" data-callback="onTurnstileSuccess" data-sitekey="{{.TurnstileSiteKey}}"></div>
      </div>
      <button id="submit-btn" class="btn btn-primary w-full" type="submit" disabled>Create account</button>
    </form>

    <div class="mt-6 flex justify-between text-sm">
      <a class="text-ink-muted hover:text-accent" href="/signin">Already have an account?</a>
      <a class="text-ink-muted hover:text-accent" href="/auth/passwordless/signup">Use a magic link</a>
    </div>
  </div>
</div>

<script>
  function onTurnstileSuccess() {
    document.getElementById('submit-btn').disabled = false;
  }
</script>

{{template "footer" .}}
