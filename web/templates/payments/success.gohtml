{{template "header" .}}

<div class="page-narrow">
  <div class="card-raised mx-auto max-w-xl p-8 text-center">
    <div class="mx-auto mb-5 flex size-14 items-center justify-center rounded-full bg-success-wash text-success">
      <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
    </div>
    <h1 class="headline-md text-ink">Welcome to premium</h1>
    <p class="mt-2 text-ink-muted">Your subscription is active. A confirmation email is on its way.</p>

    <div class="callout callout-ok mt-6 text-left">
      <p>You now have 100 bookmarks and 10 AI questions per day.</p>
    </div>

    <div class="mt-7 flex flex-col justify-center gap-3 sm:flex-row">
      <a href="/home" class="btn btn-primary">Go to your library</a>
      <form action="/payments/create-portal-session" method="POST">
        {{csrfField}}
        <input type="hidden" name="session_id" value="{{.SessionId}}" />
        <button type="submit" class="btn btn-secondary w-full">Manage billing</button>
      </form>
    </div>

    <p class="mt-8 border-t border-line pt-6 text-sm text-ink-muted">
      Need help? <a href="/contact" class="link">Get in touch</a>
    </p>
  </div>
</div>

{{template "footer" .}}
