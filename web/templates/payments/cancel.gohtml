{{template "header" .}}

<div class="page-narrow">
  <div class="card-raised mx-auto max-w-xl p-8 text-center">
    <h1 class="headline-md text-ink">Checkout cancelled</h1>
    <p class="mt-2 text-ink-muted">No worries. Nothing was charged, and your free account works as before.</p>

    <div class="mt-7 flex flex-col justify-center gap-3 sm:flex-row">
      <a href="/home" class="btn btn-primary">Back to your library</a>
      <a href="/users/subscribe" class="btn btn-secondary">View premium</a>
    </div>
  </div>
</div>

{{template "footer" .}}
