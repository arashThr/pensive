{{template "recent-results" .}}

{{define "recent-results"}}
{{if .HasBookmarksAtAll}}
<div class="mb-4 flex items-baseline justify-between">
  <h2 class="eyebrow text-ink-faint">Recently saved</h2>
  <span class="text-[13px] text-ink-faint">{{.Count}} bookmarks</span>
</div>

<div class="space-y-3">
  {{range .Bookmarks}}
  <a href="/bookmarks/{{.Id}}" class="card-link px-5 py-4 sm:px-6 sm:py-5">
    <div class="meta mb-2">
      <span class="flex size-6 items-center justify-center rounded-md bg-surface-strong">
        <img src="https://www.google.com/s2/favicons?domain={{.Link}}&sz=64" alt="" class="size-4 rounded-sm" loading="lazy" onerror="this.remove()" />
      </span>
      <span class="text-ink-muted">{{.Hostname}}</span>
      <span aria-hidden="true">·</span>
      <span>{{.CreatedAt}}</span>
    </div>
    <h3 class="title line-clamp-2 wrap-break-word">{{.Title}}</h3>
    {{if .Excerpt}}
    <p class="mt-1 line-clamp-2 text-ink-muted">{{.Excerpt}}</p>
    {{end}}
  </a>
  {{end}}
</div>

{{template "pagination" .}}
{{else}}
<!-- Empty State -->
<div class="card px-6 py-14 text-center">
  <div class="icon-tile mx-auto mb-5 size-14 rounded-2xl">
    <svg class="h-7 w-7 text-accent" fill="currentColor" viewBox="0 0 24 24">
      <path d="M6.5 2.5h11A1.5 1.5 0 0 1 19 4v16.2a.8.8 0 0 1-1.25.66L12 17l-5.75 3.86A.8.8 0 0 1 5 20.2V4a1.5 1.5 0 0 1 1.5-1.5z"/>
    </svg>
  </div>
  <h3 class="headline-md text-ink">Your shelves are empty</h3>
  <p class="mx-auto mt-2 mb-7 max-w-sm text-ink-muted">
    Save your first article and it becomes searchable, word for word.
  </p>
  <a href="/bookmarks/new" class="btn btn-primary">
    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
    </svg>
    Add your first bookmark
  </a>
</div>
{{end}}
{{end}}
