{{template "recent-results" .}}

{{define "recent-results"}}
{{if .HasBookmarksAtAll}}
<h2 class="eyebrow mb-3 text-ink-faint">Recently saved</h2>

<ul class="card divide-y divide-line overflow-hidden">
  {{range .Bookmarks}}
  <li>
    <a href="/bookmarks/{{.Id}}" class="flex items-start gap-3 px-4 py-3 transition-colors hover:bg-surface">
      <img src="https://www.google.com/s2/favicons?domain={{.Link}}&sz=64" alt="" class="mt-0.5 size-4 shrink-0 rounded-sm" loading="lazy" onerror="this.style.visibility='hidden'" />
      <span class="min-w-0 flex-1">
        <span class="line-clamp-2 font-medium wrap-break-word text-ink">{{.Title}}</span>
        <span class="meta mt-0.5">
          <span class="truncate">{{.Hostname}}</span>
          <span aria-hidden="true">·</span>
          <span>{{.CreatedAt}}</span>
        </span>
      </span>
    </a>
  </li>
  {{end}}
</ul>

{{template "pagination" .}}
{{else}}
<!-- Empty State -->
<div class="card px-6 py-14 text-center">
  <div class="icon-tile mx-auto mb-5 size-14 rounded-2xl">
    <svg class="h-7 w-7 text-accent" fill="currentColor" viewBox="0 0 24 24">
      <path d="M6.5 2.5h11A1.5 1.5 0 0 1 19 4v16.2a.8.8 0 0 1-1.25.66L12 17l-5.75 3.86A.8.8 0 0 1 5 20.2V4a1.5 1.5 0 0 1 1.5-1.5z"/>
    </svg>
  </div>
  <h3 class="headline-md text-ink">Your shelves are empty</h3>
  <p class="mx-auto mt-2 mb-7 max-w-sm text-ink-muted">
    Save your first article and it becomes searchable, word for word.
  </p>
  <a href="/bookmarks/new" class="btn btn-primary">
    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
    </svg>
    Add your first bookmark
  </a>
</div>
{{end}}
{{end}}
