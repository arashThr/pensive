{{template "header" .}}

<div class="page">
  <div class="mx-auto max-w-3xl">
    <div class="mb-8">
      <h1 class="headline text-ink">Your library</h1>
      <p class="lede mt-1">Search what you've saved, or ask a question across all of it.</p>
    </div>

    <!-- Search / Ask tabs -->
    <div class="segmented mb-4 max-w-xs" role="tablist">
      <button id="search-tab" class="segmented-item" role="tab" aria-selected="true" onclick="switchTab('search')">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        Search
      </button>
      <button id="ask-tab" class="segmented-item" role="tab" aria-selected="false" onclick="switchTab('ask')">
        <svg class="h-4 w-4 text-notice" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2l1.9 5.6L19.5 9.5l-5.6 1.9L12 17l-1.9-5.6L4.5 9.5l5.6-1.9L12 2zm7 11l.95 2.55L22.5 16.5l-2.55.95L19 20l-.95-2.55L15.5 16.5l2.55-.95L19 13z"/>
        </svg>
        Ask AI
      </button>
    </div>

    <!-- Search mode -->
    <div id="search-mode" class="flex items-center gap-3">
      <div class="relative flex-1">
        <svg class="pointer-events-none absolute top-1/2 left-4 h-5 w-5 -translate-y-1/2 text-ink-faint" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input
          type="search"
          placeholder="Search your collection…"
          class="input h-[52px] rounded-2xl border-[1.5px] bg-paper pr-12 pl-12"
          id="search-input"
          name="query"
          autocomplete="off"
          hx-get="/home/search"
          hx-target="#results"
          hx-trigger="input changed delay:300ms, search"
          hx-indicator="#search-loading"
        />
        <span id="search-loading" class="htmx-indicator absolute top-1/2 right-4 -translate-y-1/2">
          <span class="spinner"></span>
        </span>
      </div>
      <a href="/bookmarks/new" class="btn btn-primary h-[52px] rounded-2xl" title="Add bookmark manually">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
        <span class="hidden sm:inline">Add</span>
      </a>
    </div>

    <!-- Ask mode -->
    <div id="ask-mode" class="hidden">
      <div class="card-raised p-2 focus-within:border-accent focus-within:ring-3 focus-within:ring-accent/12">
        <textarea
          name="question"
          id="question-input"
          rows="3"
          placeholder="Ask anything about what you've saved…"
          class="block w-full resize-none bg-transparent px-3 py-2 text-[15px] text-ink outline-none placeholder:text-ink-faint"
        ></textarea>
        <div class="flex items-center justify-between gap-3 px-2 pb-1">
          <span class="text-[13px] text-ink-faint">{{.RemainingAIQuestions}} questions left today</span>
          <button
            type="button"
            id="ask-button"
            class="btn btn-sm btn-primary"
            hx-post="/home/ask"
            hx-include="[name='question']"
            hx-target="#results"
            hx-swap="innerHTML"
            hx-indicator="#ask-loading"
            hx-disabled-elt="this"
          >
            Ask
          </button>
        </div>
      </div>
      <div id="ask-loading" class="htmx-indicator mt-4 flex items-center justify-center gap-2 text-sm text-ink-muted">
        <span class="spinner size-4"></span>
        Reading through your library…
      </div>
    </div>

    <!-- Email Verification Notice -->
    {{if not .EmailVerified}}
    <div class="callout callout-warn mt-6">
      <svg class="mt-0.5 h-5 w-5 shrink-0 text-notice" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
      </svg>
      <div class="flex-1">
        <p class="font-semibold">Verify your email</p>
        <p class="mt-0.5 mb-3">Your collection is limited to {{.RemainingBookmarks}} bookmarks until you verify your email address.</p>
        <button
          id="resend-btn"
          class="btn btn-sm btn-secondary"
          hx-post="/auth/resend-verification"
          hx-swap="outerHTML"
          hx-disabled-elt="this"
        >
          Resend verification email
        </button>
      </div>
    </div>
    {{end}}

    <!-- Results -->
    <div id="results" class="mt-8">
      {{template "recent-results" .}}
    </div>
  </div>
</div>

<script>
  function switchTab(mode) {
    const isSearch = mode === 'search';
    document.getElementById('search-tab').setAttribute('aria-selected', isSearch);
    document.getElementById('ask-tab').setAttribute('aria-selected', !isSearch);
    document.getElementById('search-mode').classList.toggle('hidden', !isSearch);
    document.getElementById('ask-mode').classList.toggle('hidden', isSearch);

    const results = document.getElementById('results');
    if (isSearch) {
      // Search endpoint with no query returns recent bookmarks
      document.getElementById('search-input').value = '';
      results.classList.remove('hidden');
      htmx.ajax('GET', '/home/search', {target: '#results', swap: 'innerHTML'});
    } else {
      // Recent bookmarks aren't shown in Ask AI mode until an answer arrives
      results.classList.add('hidden');
      const question = document.getElementById('question-input');
      question.value = '';
      question.focus();
    }
  }

  document.addEventListener('DOMContentLoaded', function () {
    const questionInput = document.getElementById('question-input');
    const askButton = document.getElementById('ask-button');
    const results = document.getElementById('results');

    // Enter submits, Shift+Enter adds a new line
    questionInput.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        askButton.click();
      }
    });

    results.addEventListener('htmx:afterSwap', function () {
      results.classList.remove('hidden');
    });
  });
</script>

{{template "footer" .}}
