{{template "header" .}}

<div class="page">
  <div class="mx-auto max-w-3xl">
    <div class="mb-8">
      <h1 class="headline text-ink">Your library</h1>
      <p class="lede mt-1">Search what you've saved, or ask a question across all of it.</p>
    </div>

    <!-- One box: typing searches; Enter with no matches (or the Ask AI button) asks AI -->
    <div class="flex items-center gap-3">
      <div id="search-box" class="relative flex-1">
        <svg class="pointer-events-none absolute top-1/2 left-4 h-5 w-5 -translate-y-1/2 text-ink-faint" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input
          type="search"
          id="search-input"
          placeholder="Search your library, or ask a question…"
          class="input h-[52px] rounded-2xl border-[1.5px] bg-paper pr-32 pl-12"
          autocomplete="off"
          aria-describedby="search-hint"
        />
        <div class="absolute top-1/2 right-2 flex -translate-y-1/2 items-center gap-2">
          <span id="search-loading" class="spinner hidden size-4"></span>
          <button type="button" id="ask-button" class="btn btn-sm btn-ghost hidden" title="Ask AI about this">
            <svg class="h-4 w-4 text-notice" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2l1.9 5.6L19.5 9.5l-5.6 1.9L12 17l-1.9-5.6L4.5 9.5l5.6-1.9L12 2zm7 11l.95 2.55L22.5 16.5l-2.55.95L19 20l-.95-2.55L15.5 16.5l2.55-.95L19 13z"/>
            </svg>
            Ask AI
          </button>
        </div>
      </div>
      <a href="/bookmarks/new" class="btn btn-primary h-[52px] rounded-2xl" title="Add bookmark manually">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
        <span class="hidden sm:inline">Add</span>
      </a>
    </div>
    <p id="search-hint" class="mt-2 px-1 text-[13px] text-ink-faint">
      No matches? Press <kbd class="rounded border border-line bg-paper px-1 font-mono text-[11px]">Enter</kbd> to ask AI<span class="mx-1.5" aria-hidden="true">·</span>{{.RemainingAIQuestions}} AI questions left today
    </p>

    <template id="ask-loading">
      <div class="flex items-center justify-center gap-2 py-10 text-sm text-ink-muted">
        <span class="spinner size-4"></span>
        Reading through your library…
      </div>
    </template>
    <template id="load-error">
      <div class="callout callout-danger">Something went wrong. Please try again.</div>
    </template>

    <!-- Email Verification Notice -->
    {{if not .EmailVerified}}
    <div class="callout callout-warn mt-6">
      <svg class="mt-0.5 h-5 w-5 shrink-0 text-notice" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
      </svg>
      <div class="flex-1">
        <p class="font-semibold">Verify your email</p>
        <p class="mt-0.5 mb-3">Your collection is limited to {{.RemainingBookmarks}} bookmarks until you verify your email address.</p>
        <button
          id="resend-btn"
          class="btn btn-sm btn-secondary"
          hx-post="/auth/resend-verification"
          hx-swap="outerHTML"
          hx-disabled-elt="this"
        >
          Resend verification email
        </button>
      </div>
    </div>
    {{end}}

    <!-- Results -->
    <div id="results" class="mt-8">
      {{template "recent-results" .}}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const input = document.getElementById('search-input');
    const askButton = document.getElementById('ask-button');
    const spinner = document.getElementById('search-loading');
    const results = document.getElementById('results');
    let timer;
    let latest = 0;        // id of the most recent request; older responses are dropped
    let searched = null;   // query whose results are currently shown

    async function load(url, options) {
      const id = ++latest;
      let html;
      try {
        const res = await fetch(url, options);
        html = res.ok ? await res.text() : document.getElementById('load-error').innerHTML;
      } catch {
        html = document.getElementById('load-error').innerHTML;
      }
      if (id !== latest) return false;
      results.innerHTML = html;
      htmx.process(results);
      return true;
    }

    async function search() {
      clearTimeout(timer);
      const query = input.value.trim();
      searched = query;
      spinner.classList.remove('hidden');
      const shown = await load('/home/search?query=' + encodeURIComponent(query));
      spinner.classList.add('hidden');
      return shown;
    }

    function ask(question) {
      if (!question) return;
      clearTimeout(timer);
      results.innerHTML = document.getElementById('ask-loading').innerHTML;
      return load('/home/ask', {method: 'POST', body: new URLSearchParams({question})});
    }

    input.addEventListener('input', function () {
      askButton.classList.toggle('hidden', !input.value.trim());
      clearTimeout(timer);
      timer = setTimeout(search, 300);
    });

    // Enter: make sure results are for the current text, then ask AI if nothing matched
    input.addEventListener('keydown', async function (e) {
      if (e.key !== 'Enter') return;
      e.preventDefault();
      const query = input.value.trim();
      if (!query) return;
      if (searched !== query && !(await search())) return;
      if (results.querySelector('[data-no-results]')) ask(query);
    });

    askButton.addEventListener('click', () => ask(input.value.trim()));
    results.addEventListener('click', function (e) {
      if (e.target.closest('[data-ask]')) ask(input.value.trim());
    });
  });
</script>

{{template "footer" .}}
