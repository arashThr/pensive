{{if .HasResults}}
<div class="mb-4 flex items-baseline justify-between gap-4">
  <h2 class="eyebrow text-ink-faint">Search results</h2>
  <span class="truncate text-[13px] text-ink-faint">
    {{len .Bookmarks}} result{{if ne (len .Bookmarks) 1}}s{{end}} for “{{.Query}}”
  </span>
</div>

<div class="space-y-3">
  {{range .Bookmarks}}
  <a href="/bookmarks/{{.Id}}" class="card-link px-5 py-4 sm:px-6 sm:py-5">
    <div class="meta mb-2">
      <span class="flex size-6 items-center justify-center rounded-md bg-surface-strong">
        <img src="https://www.google.com/s2/favicons?domain={{.Link}}&sz=64" alt="" class="size-4 rounded-sm" loading="lazy" onerror="this.remove()" />
      </span>
      <span class="text-ink-muted">{{.Hostname}}</span>
      <span aria-hidden="true">·</span>
      <span>{{.CreatedAt.Format "Jan 02, 2006"}}</span>
    </div>
    <h3 class="title line-clamp-2 wrap-break-word">{{.Title}}</h3>
    {{if .Headline}}
    <p class="search-snippet mt-1 line-clamp-2 text-ink-muted">{{safeHTML .Headline}}</p>
    {{end}}
  </a>
  {{end}}
</div>
{{else}}
<!-- Empty Search Results -->
<div class="card px-6 py-14 text-center">
  <div class="icon-tile mx-auto mb-5 size-14 rounded-2xl">
    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
  </div>
  <h3 class="headline-md text-ink">Nothing found for “{{.Query}}”</h3>
  <p class="mx-auto mt-2 mb-7 max-w-sm text-ink-muted">
    Try different keywords, or switch to Ask AI to search by meaning.
  </p>
  <a href="/bookmarks/new" class="btn btn-secondary">Add a bookmark</a>
</div>
{{end}}
