{{template "header" .}}

<div class="page-narrow">
  <div class="mb-8">
    <h1 class="headline text-ink">Integrations</h1>
    <p class="lede mt-1">Save from anywhere, bring your old library, or build your own tools.</p>
  </div>

  <div class="mb-8 flex gap-6 overflow-x-auto border-b border-line" role="tablist">
    <button class="tab-underline" role="tab" data-tab="browser" aria-selected="true">Browser extension</button>
    <button class="tab-underline" role="tab" data-tab="telegram" aria-selected="false">Telegram bot</button>
    <button class="tab-underline" role="tab" data-tab="pocket" aria-selected="false">Pocket import</button>
    <button class="tab-underline" role="tab" data-tab="api" aria-selected="false">API access</button>
  </div>

  <!-- Browser -->
  <section id="content-browser" class="card p-6 sm:p-8" data-panel>
    <div class="flex items-center gap-3">
      <img src="/assets/icons/chrome.svg" alt="" class="size-9">
      <img src="/assets/icons/firefox.svg" alt="" class="size-9">
    </div>
    <h2 class="headline-md mt-4 text-ink">Browser extension</h2>
    <p class="mt-1 text-ink-muted">One click saves any page with its full text. Works on Chrome and Firefox.</p>

    <ol class="mt-6 space-y-3 text-sm text-ink-muted">
      <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-accent-wash text-xs font-bold text-accent">1</span> Install the extension from your browser's store.</li>
      <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-accent-wash text-xs font-bold text-accent">2</span> Create an API token in your account settings.</li>
      <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-accent-wash text-xs font-bold text-accent">3</span> Click the extension icon on any page to save it.</li>
    </ol>

    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href="https://chromewebstore.google.com/detail/pensive-save-search-what/klmginbbicjdpaodcbokdjbhnbaocomd" target="_blank" rel="noopener" class="btn btn-primary">Add to Chrome</a>
      <a href="https://addons.mozilla.org/en-US/firefox/addon/pensive/" target="_blank" rel="noopener" class="btn btn-secondary">Add to Firefox</a>
    </div>
  </section>

  <!-- Telegram -->
  <section id="content-telegram" class="card hidden p-6 sm:p-8" data-panel>
    <img src="/assets/icons/telegram.svg" alt="" class="size-9">
    <div class="mt-4 flex flex-wrap items-center gap-3">
      <h2 class="headline-md text-ink">Telegram bot</h2>
      {{if .TelegramLinked}}
        <span class="badge badge-ok">Connected</span>
      {{else}}
        <span class="badge bg-surface-strong text-ink-muted">Not connected</span>
      {{end}}
    </div>
    <p class="mt-1 text-ink-muted">Save links from your phone and search your library right in the chat.</p>

    <ul class="mt-6 space-y-2 text-sm text-ink-muted">
      <li class="flex items-center gap-2"><svg class="h-4 w-4 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Forward any link and it's saved instantly</li>
      <li class="flex items-center gap-2"><svg class="h-4 w-4 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Search your whole library from Telegram</li>
    </ul>

    <a href="/telegram/auth" class="btn btn-primary mt-8">{{if .TelegramLinked}}Reconnect Telegram{{else}}Connect Telegram{{end}}</a>
  </section>

  <!-- Pocket -->
  <section id="content-pocket" class="card hidden p-6 sm:p-8" data-panel>
    <img src="/assets/icons/pocket.png" alt="" class="size-9">
    <h2 class="headline-md mt-4 text-ink">Pocket import</h2>
    <p class="mt-1 text-ink-muted">Bring over your Pocket bookmarks with their tags and dates.</p>

    <ol class="mt-6 space-y-3 text-sm text-ink-muted">
      <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-accent-wash text-xs font-bold text-accent">1</span> Export your archive from your Pocket account.</li>
      <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-accent-wash text-xs font-bold text-accent">2</span> Upload the ZIP file on the import page.</li>
      <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-accent-wash text-xs font-bold text-accent">3</span> Processing runs in the background.</li>
    </ol>

    <a href="/pocket" class="btn btn-primary mt-8">Start Pocket import</a>
  </section>

  <!-- API -->
  <section id="content-api" class="card hidden p-6 sm:p-8" data-panel>
    <div class="flex flex-wrap items-center gap-3">
      <h2 class="headline-md text-ink">API access</h2>
      {{if .LoggedIn}}<span class="badge bg-surface-strong text-ink-muted">{{.TokensCount}} active tokens</span>{{end}}
    </div>
    <p class="mt-1 text-ink-muted">Build your own workflows and connect external tools.</p>

    <ul class="mt-6 space-y-2 text-sm text-ink-muted">
      <li class="flex items-center gap-2"><svg class="h-4 w-4 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> REST API for saving and searching bookmarks</li>
      <li class="flex items-center gap-2"><svg class="h-4 w-4 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Token-based auth for extensions and scripts</li>
      <li class="flex items-center gap-2"><svg class="h-4 w-4 text-ink-faint" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> Webhooks coming soon</li>
    </ul>

    {{if .LoggedIn}}
      <a href="/users/me?tab=tokens" class="btn btn-primary mt-8">Manage API tokens</a>
    {{else}}
      <a href="/signin" class="btn btn-primary mt-8">Sign in for API access</a>
    {{end}}
  </section>

  <p class="mt-10 text-center text-sm text-ink-muted">
    IFTTT, Zapier, RSS and more are on the way. <a href="/contact" class="link">Suggest an integration</a>
  </p>
</div>

<script>
  document.querySelectorAll('[data-tab]').forEach((tab) => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('[data-tab]').forEach((t) => t.setAttribute('aria-selected', t === tab));
      document.querySelectorAll('[data-panel]').forEach((p) => p.classList.toggle('hidden', p.id !== 'content-' + tab.dataset.tab));
    });
  });
</script>

{{template "footer" .}}
