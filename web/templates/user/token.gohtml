{{if .ErrorMessage}}
  <div class="callout callout-danger">
    <div>
      <p class="font-semibold">Couldn't generate a token</p>
      <p class="mt-1 font-mono text-[13px]">{{.ErrorMessage}}</p>
    </div>
  </div>
{{else}}
  <div class="card p-6">
    <h3 class="title mb-4">Your new API token</h3>
    <label class="label" for="api-token">Token</label>
    <div class="flex items-center gap-2">
      <input class="input font-mono text-sm" type="text" value="{{.APIToken}}" readonly id="api-token" onclick="this.select()" />
      <button class="btn btn-secondary" onclick="copyToken(this)">Copy</button>
    </div>
    <div class="callout callout-warn mt-4">
      <p>Store this token safely. It won't be shown again and gives full access to your bookmarks.</p>
    </div>
  </div>
  <script>
    function copyToken(button) {
      navigator.clipboard.writeText(document.getElementById('api-token').value).then(() => {
        button.textContent = 'Copied';
        setTimeout(() => { button.textContent = 'Copy'; }, 2000);
      });
    }
  </script>
{{end}}
