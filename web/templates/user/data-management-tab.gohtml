<div class="space-y-6">
  <div>
    <h2 class="headline-md text-ink">Data management</h2>
    <p class="mt-1 text-ink-muted">These actions are permanent. Consider exporting your data first.</p>
  </div>

  <div class="card flex flex-col gap-4 p-6 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h3 class="title">Delete all content</h3>
      <p class="mt-1 text-sm text-ink-muted">Permanently removes every saved bookmark. Your account stays active.</p>
    </div>
    <button class="btn btn-secondary text-danger hover:border-danger/30 hover:bg-danger-wash" onclick="toggleModal('delete-content-modal', true)">
      Delete content
    </button>
  </div>

  <div class="card flex flex-col gap-4 border-danger/20 p-6 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h3 class="title">Delete account</h3>
      <p class="mt-1 text-sm text-ink-muted">Removes your account, content, settings, subscription and API tokens. Cancel any active subscription first.</p>
    </div>
    <button class="btn btn-danger" onclick="toggleModal('delete-account-modal', true)">
      Delete account
    </button>
  </div>
</div>

<div id="delete-content-modal" class="modal-backdrop" onclick="if (event.target === this) toggleModal(this.id, false)">
  <div class="modal">
    <h3 class="headline-md text-ink">Delete all content?</h3>
    <p class="mt-3 text-ink-muted">Every bookmark and its content will be permanently deleted.</p>
    <p class="mt-2 mb-6 text-sm font-semibold text-danger">This cannot be undone. Have you backed up your data?</p>
    <div class="flex justify-end gap-3">
      <button class="btn btn-secondary" onclick="toggleModal('delete-content-modal', false)">Cancel</button>
      <form action="/users/delete-content" method="POST">
        {{csrfField}}
        <button type="submit" class="btn btn-danger">Delete all content</button>
      </form>
    </div>
  </div>
</div>

<div id="delete-account-modal" class="modal-backdrop" onclick="if (event.target === this) toggleModal(this.id, false)">
  <div class="modal">
    <h3 class="headline-md text-ink">Delete your account?</h3>
    <p class="mt-3 text-ink-muted">Everything associated with your account will be permanently deleted.</p>
    <p class="mt-2 mb-6 text-sm font-semibold text-danger">This cannot be undone.</p>
    <div class="flex justify-end gap-3">
      <button class="btn btn-secondary" onclick="toggleModal('delete-account-modal', false)">Cancel</button>
      <form action="/users/delete-account" method="POST">
        {{csrfField}}
        <button type="submit" class="btn btn-danger">Delete my account</button>
      </form>
    </div>
  </div>
</div>

<script>
  function toggleModal(id, open) {
    const modal = document.getElementById(id);
    modal.classList.toggle('hidden', !open);
    modal.classList.toggle('flex', open);
  }
</script>
