<div class="space-y-6">
  <div>
    <h2 class="headline-md text-ink">API tokens</h2>
    <p class="mt-1 text-ink-muted">Apps and services connected to your account.</p>
  </div>

  {{if .Tokens}}
    <ul class="card divide-y divide-line">
      {{range $index, $token := .Tokens}}
        <li id="token-{{$index}}" class="flex items-center gap-4 p-5">
          <div class="icon-tile">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
            </svg>
          </div>
          <div class="min-w-0 flex-1">
            <p class="title truncate">{{$token.TokenSource}}</p>
            <p class="meta mt-0.5">
              <span>Connected {{$token.CreatedAt.Format "Jan 2, 2006"}}</span>
              <span aria-hidden="true">·</span>
              <span>Last used {{if $token.LastUsedAt}}{{$token.LastUsedAt.Format "Jan 2, 2006"}}{{else}}never{{end}}</span>
            </p>
          </div>
          <form>
            {{csrfField}}
            <input type="hidden" name="token_id" value="{{$token.ID}}">
            <button
              type="button"
              class="btn btn-sm btn-ghost text-danger hover:bg-danger-wash hover:text-danger"
              hx-post="/users/delete-token"
              hx-confirm="Disconnect this integration? It will stop working immediately."
              hx-target="#token-{{$index}}"
              hx-swap="outerHTML">
              Remove
            </button>
          </form>
        </li>
      {{end}}
    </ul>
    <div class="callout callout-warn">
      <svg class="mt-0.5 h-5 w-5 shrink-0 text-amber" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-2.694-.833-3.464 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z" />
      </svg>
      <p>Removing a token stops that integration from working. This cannot be undone.</p>
    </div>
  {{else}}
    <div class="card px-6 py-12 text-center">
      <h3 class="title">No tokens yet</h3>
      <p class="mx-auto mt-1 mb-6 max-w-sm text-ink-muted">Install the browser extension or Telegram bot to connect them to your library.</p>
      <a href="/integrations" class="btn btn-primary">View integrations</a>
    </div>
  {{end}}
</div>
