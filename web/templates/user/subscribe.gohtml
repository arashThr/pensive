{{template "header" .}}

<div class="page">
  <div class="mx-auto mb-10 max-w-xl text-center">
    {{if .IsSubscribed}}
      <h1 class="headline text-ink">Your premium plan</h1>
      <p class="lede mt-2">Thank you for supporting Pensive. You have the full set of daily limits.</p>
    {{else}}
      <h1 class="headline text-ink">Choose your plan</h1>
      <p class="lede mt-2">Every feature is free. Premium raises your daily limits and supports development.</p>
    {{end}}
  </div>

  <div class="mx-auto grid max-w-3xl gap-4 md:grid-cols-2">
    <!-- Free -->
    <div class="card flex flex-col p-6 sm:p-8">
      <p class="eyebrow text-ink-faint">Free</p>
      <p class="mt-2 font-display text-4xl font-bold text-ink">$0</p>
      <p class="mt-1 text-sm text-ink-muted">Forever free</p>
      <ul class="mt-6 flex-1 space-y-2.5 text-sm text-ink-muted">
        <li><strong class="text-ink">10</strong> bookmarks/day</li>
        <li><strong class="text-ink">1</strong> AI question/day</li>
        <li>Full-text search</li>
        <li>Browser extension & Telegram bot</li>
        <li>AI summaries & tags</li>
      </ul>
      {{if not .IsSubscribed}}
        <a href="/home" class="btn btn-secondary mt-8 w-full">Continue free</a>
      {{end}}
    </div>

    <!-- Premium -->
    <div class="card-raised flex flex-col border-accent/40 p-6 sm:p-8">
      <div class="flex items-center justify-between">
        <p class="eyebrow text-accent">Premium</p>
        {{if .IsSubscribed}}<span class="badge badge-ok">Your plan</span>{{end}}
      </div>
      <p class="mt-2 font-display text-4xl font-bold text-ink">$5 <span class="font-sans text-base font-normal text-ink-muted">/ month</span></p>
      <p class="mt-1 text-sm text-ink-muted">More headroom for saving and asking</p>
      <ul class="mt-6 flex-1 space-y-2.5 text-sm text-ink-muted">
        <li><strong class="text-ink">100</strong> bookmarks/day</li>
        <li><strong class="text-ink">10</strong> AI questions/day</li>
        <li>Everything in Free</li>
        <li>Priority support</li>
        <li>Early access to new features</li>
      </ul>
      <div class="mt-8">
        {{if .IsSubscribed}}
          <a href="/payments/portal-session" class="btn btn-secondary w-full">Manage subscription</a>
        {{else if isSubscriptionEnabled}}
          <form action="/payments/create-checkout-session" method="post">
            {{csrfField}}
            <button type="submit" class="btn btn-primary w-full">Subscribe</button>
          </form>
        {{else}}
          <button type="button" class="btn btn-primary w-full" disabled>Coming soon</button>
        {{end}}
      </div>
    </div>
  </div>
</div>

{{template "footer" .}}
