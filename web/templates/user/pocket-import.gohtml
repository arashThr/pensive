{{template "header" .}}

<div class="page-narrow">
  <div class="mx-auto max-w-xl">
    <h1 class="headline text-ink">Import from Pocket</h1>
    <p class="lede mt-1">Upload your Pocket export to bring your saved articles into Pensive.</p>

    <form action="/users/pocket-import" method="post" enctype="multipart/form-data" class="card-raised mt-8 p-6">
      <input type="hidden" name="source" value="pocket">
      <label for="import-file" class="label">Pocket export (.zip)</label>
      <input id="import-file" name="import-file" type="file" accept=".zip" required
        class="input cursor-pointer py-2.5 file:mr-4 file:cursor-pointer file:rounded-md file:border-0 file:bg-surface-strong file:px-3 file:py-1 file:text-sm file:font-semibold file:text-ink hover:file:bg-line">
      <button type="submit" class="btn btn-primary mt-5 w-full">Begin import</button>
    </form>

    <div class="card mt-6 p-6">
      <h2 class="title mb-3">How to export from Pocket</h2>
      <ol class="list-inside list-decimal space-y-1.5 text-ink-muted">
        <li>Go to <a href="https://getpocket.com/export" target="_blank" rel="noopener" class="link">getpocket.com/export</a></li>
        <li>Click “Export CSV file”</li>
        <li>Download the ZIP file when it's ready</li>
        <li>Upload that ZIP file here</li>
      </ol>
    </div>
  </div>
</div>

{{template "footer" .}}
