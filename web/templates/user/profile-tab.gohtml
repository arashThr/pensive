<div class="space-y-6">
  <h2 class="headline-md text-ink">Profile</h2>

  <div class="card p-6">
    <p class="label">Email address</p>
    <p class="font-medium text-ink">{{.Email}}</p>
  </div>

  <div class="card p-6">
    <div class="mb-3 flex items-center gap-3">
      <h3 class="title">Subscription</h3>
      {{if .IsSubscribed}}
        <span class="badge badge-ok">Premium</span>
      {{else}}
        <span class="badge bg-surface-strong text-ink-muted">Free</span>
      {{end}}
    </div>

    {{if .IsSubscribed}}
      <p class="mb-5 text-ink-muted">You have 100 bookmarks and 10 AI questions per day, plus priority support. Thank you for supporting Pensive.</p>
      <a href="/payments/portal-session" class="btn btn-secondary">Manage subscription</a>
    {{else}}
      <p class="mb-4 text-ink-muted">Every feature is included. Premium raises your daily limits:</p>
      <ul class="mb-6 space-y-2 text-sm text-ink-muted">
        <li class="flex items-center gap-2">
          <svg class="h-4 w-4 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
          100 bookmarks/day (instead of 10)
        </li>
        <li class="flex items-center gap-2">
          <svg class="h-4 w-4 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
          10 AI questions/day (instead of 1)
        </li>
        <li class="flex items-center gap-2">
          <svg class="h-4 w-4 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
          Priority support
        </li>
      </ul>
      <a href="/users/subscribe" class="btn btn-primary">See premium</a>
    {{end}}
  </div>
</div>
