{{template "header" .}}
<meta http-equiv="refresh" content="10;url=/users/import-status?job_id={{.JobID}}">

<div class="page-narrow">
  <div class="card-raised mx-auto max-w-xl p-8 text-center">
    <span class="spinner mx-auto mb-6 size-10 border-[3px]"></span>
    <h1 class="headline-md text-ink">Importing your library</h1>
    <p class="mt-2 text-ink-muted">We're bringing in your {{.Source}} data. Depending on how many bookmarks you have, this may take a few minutes.</p>

    <ul class="mx-auto mt-6 max-w-xs space-y-2 text-left text-sm text-ink-muted">
      <li class="flex items-center gap-2"><span class="size-1.5 rounded-full bg-forest"></span> File uploaded and validated</li>
      <li class="flex items-center gap-2"><span class="size-1.5 rounded-full bg-clay"></span> Processing bookmarks and metadata</li>
      <li class="flex items-center gap-2"><span class="size-1.5 rounded-full bg-line-strong"></span> Adding them to your library</li>
    </ul>

    <p class="mt-8 text-sm text-ink-faint">This page refreshes automatically.</p>
    <div class="mt-3 flex flex-col justify-center gap-3 sm:flex-row">
      <a href="/users/import-status?job_id={{.JobID}}" class="btn btn-secondary">View import status</a>
      <a href="/home" class="btn btn-ghost">Go to library</a>
    </div>
  </div>
</div>

{{template "footer" .}}
