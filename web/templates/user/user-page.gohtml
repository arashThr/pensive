{{template "header" .}}

<div class="page">
  <div class="mb-8">
    <h1 class="headline text-ink">Settings</h1>
    <p class="lede mt-1">Manage your profile, integrations, and data.</p>
  </div>

  <div class="flex flex-col gap-6 lg:flex-row lg:gap-10">
    <!-- Mobile tab selector -->
    <select id="mobile-tab-select" class="input lg:hidden" aria-label="Settings section">
      <option value="profile">Profile</option>
      <option value="tokens">API tokens</option>
      <option value="import-export">Import / export</option>
      <option value="data-management">Data management</option>
    </select>

    <!-- Desktop sidebar -->
    <nav class="hidden shrink-0 space-y-1 lg:block lg:w-56" role="tablist">
      <button class="nav-item" role="tab" data-tab="profile">Profile</button>
      <button class="nav-item" role="tab" data-tab="tokens">API tokens</button>
      <button class="nav-item" role="tab" data-tab="import-export">Import / export</button>
      <button class="nav-item" role="tab" data-tab="data-management">Data management</button>
    </nav>

    <div id="tab-content" class="min-w-0 flex-1">
      <div class="flex items-center justify-center py-16">
        <span class="spinner"></span>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const buttons = document.querySelectorAll('[data-tab]');
    const mobileSelect = document.getElementById('mobile-tab-select');

    function selectTab(tab) {
      buttons.forEach((b) => b.setAttribute('aria-selected', b.dataset.tab === tab));
      mobileSelect.value = tab;
      htmx.ajax('GET', '/users/tab-content?tab=' + encodeURIComponent(tab), {target: '#tab-content', swap: 'innerHTML'});
      history.replaceState(null, '', '?tab=' + tab);
    }

    buttons.forEach((b) => b.addEventListener('click', () => selectTab(b.dataset.tab)));
    mobileSelect.addEventListener('change', () => selectTab(mobileSelect.value));

    selectTab(new URLSearchParams(location.search).get('tab') || 'profile');
  });
</script>

{{template "footer" .}}
