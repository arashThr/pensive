{{template "header" .}}

<div class="page-narrow">
  <div class="card-raised mx-auto max-w-xl p-8 text-center">
    {{if .ImportComplete}}
      <div class="mx-auto mb-5 flex size-14 items-center justify-center rounded-full bg-success-wash text-success">
        <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <h1 class="headline-md text-ink">Import complete</h1>
      <p class="mt-2 text-ink-muted">
        Imported <strong class="text-ink">{{.ImportedCount}} bookmarks</strong> from {{.Source}}. They're searchable now.
      </p>
      <a href="/home" class="btn btn-primary mt-7">Browse your library</a>

    {{else if .ImportFailed}}
      <div class="mx-auto mb-5 flex size-14 items-center justify-center rounded-full bg-danger-wash text-danger">
        <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </div>
      <h1 class="headline-md text-ink">Import failed</h1>
      <p class="mt-2 text-ink-muted">Something went wrong while importing your {{.Source}} data.</p>
      {{if .ErrorMessage}}
        <div class="callout callout-danger mt-6 text-left">{{.ErrorMessage}}</div>
      {{end}}
      <a href="/users/pocket-import" class="btn btn-primary mt-7">Try again</a>

    {{else}}
      <meta http-equiv="refresh" content="10;url=/users/import-status?job_id={{.JobID}}">
      <span class="spinner mx-auto mb-6 size-10 border-[3px]"></span>
      <h1 class="headline-md text-ink">Import in progress</h1>
      <p class="mt-2 text-ink-muted">Your {{.Source}} import is still running. Large imports can take several minutes.</p>
      <p class="mt-6 text-sm text-ink-faint">This page refreshes automatically.</p>
    {{end}}

    <div class="mt-8 flex justify-center gap-2 border-t border-line pt-6">
      <a href="/home" class="btn btn-sm btn-ghost">Library</a>
      <a href="/users/me" class="btn btn-sm btn-ghost">Settings</a>
    </div>
  </div>
</div>

{{template "footer" .}}
