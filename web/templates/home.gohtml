{{template "header" .}}

<!-- Hero -->
<section class="mx-auto grid max-w-6xl items-center gap-14 px-4 pt-14 pb-20 sm:px-6 sm:pt-20 lg:grid-cols-[1.05fr_1fr] lg:gap-16 lg:px-8">
  <div>
    <p class="font-mono text-xs tracking-wide text-ink-faint uppercase">
      <a href="https://github.com/arashthr/pensive" target="_blank" rel="noopener" class="hover:text-accent">Open source</a>
      <span class="mx-1.5 text-line-strong">/</span> Self-hostable
      <span class="mx-1.5 text-line-strong">/</span> Free
    </p>
    <h1 class="mt-5 font-display text-[44px] leading-[1.02] font-bold tracking-[-0.04em] text-ink sm:text-[64px]">
      Your searchable <span class="hl">memory</span> of the web
    </h1>
    <p class="lede mt-6 max-w-md">
      Smart bookmarking with full-content capture and fast search. Save a page once and find it again by any word inside it.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href="/signup" class="btn btn-primary">Start saving for free</a>
      <a href="https://github.com/arashthr/pensive" target="_blank" rel="noopener" class="btn btn-secondary">
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/></svg>
        View on GitHub
      </a>
    </div>
  </div>

  <!-- Search demo: a stack of index cards with the logo's ribbon -->
  <div class="relative mx-2 sm:mx-6 lg:mx-0" aria-hidden="true">
    <div class="absolute inset-0 translate-x-4 translate-y-4 rotate-[2.5deg] rounded-2xl border border-line bg-paper"></div>
    <div class="absolute inset-0 translate-x-2 translate-y-2 rotate-[1.2deg] rounded-2xl border border-line bg-paper"></div>
    <div class="relative rounded-2xl border border-line-strong bg-paper p-4 shadow-lift sm:p-5">
      <svg class="absolute -top-2 right-8 h-16 w-9 text-accent drop-shadow-sm" viewBox="0 0 18 32" fill="currentColor"><path d="M0 0h18v30.5a.8.8 0 0 1-1.3.62L9 25l-7.7 6.12A.8.8 0 0 1 0 30.5z"/></svg>

      <div class="mr-12 flex h-12 items-center gap-3 rounded-xl border border-line bg-canvas px-4">
        <svg class="h-5 w-5 shrink-0 text-ink-faint" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        <span class="truncate text-[15px] text-ink">gardens and streams<span class="caret"></span></span>
      </div>
      <p class="mt-3 mb-1 px-1 font-mono text-[11px] text-ink-faint">3 matches in 1,284 bookmarks · 14 ms</p>

      <ul class="divide-y divide-line">
        <li class="px-1 py-3.5">
          <p class="font-mono text-[11px] text-ink-faint">hapgood.us · saved 2021</p>
          <p class="mt-0.5 font-semibold text-ink">The Garden and the Stream: A Technopastoral</p>
          <p class="mt-1 line-clamp-2 text-sm text-ink-muted">…the <mark>garden</mark> is topological, built to be revisited, while the <mark>stream</mark> is time-ordered and gone by tomorrow…</p>
        </li>
        <li class="px-1 py-3.5">
          <p class="font-mono text-[11px] text-ink-faint">maggieappleton.com · saved 2022</p>
          <p class="mt-0.5 font-semibold text-ink">A Brief History & Ethos of the Digital Garden</p>
          <p class="mt-1 line-clamp-2 text-sm text-ink-muted">…digital <mark>gardens</mark> grow ideas over time instead of publishing <mark>streams</mark> of finished posts…</p>
        </li>
        <li class="px-1 pt-3.5 pb-1">
          <p class="font-mono text-[11px] text-ink-faint">news.ycombinator.com · saved 2024</p>
          <p class="mt-0.5 font-semibold text-ink">Ask HN: How do you keep track of what you read?</p>
          <p class="mt-1 line-clamp-2 text-sm text-ink-muted">…I want a <mark>garden</mark> of everything I've read, not another <mark>stream</mark> I scroll past…</p>
        </li>
      </ul>
    </div>
  </div>
</section>

<!-- How it works -->
<section class="border-y border-line bg-paper">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8">
    <h2 class="headline max-w-xl text-ink">Save it once. Find it by any word.</h2>

    <ol class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
      <li>
        <p class="font-mono text-sm text-accent">01 — Save</p>
        <h3 class="mt-3 font-display text-2xl font-bold tracking-tight text-ink">From anywhere</h3>
        <p class="mt-2 text-ink-muted">One click in Chrome or Firefox, or forward a link to the Telegram bot from your phone.</p>
        <div class="mt-5 flex gap-2">
          <a href="https://chromewebstore.google.com/detail/pensive-save-search-what/klmginbbicjdpaodcbokdjbhnbaocomd" target="_blank" rel="noopener" class="flex size-11 items-center justify-center rounded-xl border border-line bg-canvas transition hover:border-line-strong hover:bg-paper" title="Chrome extension"><img src="/assets/icons/chrome.svg" alt="Chrome" class="size-6"></a>
          <a href="https://addons.mozilla.org/en-US/firefox/addon/pensive/" target="_blank" rel="noopener" class="flex size-11 items-center justify-center rounded-xl border border-line bg-canvas transition hover:border-line-strong hover:bg-paper" title="Firefox add-on"><img src="/assets/icons/firefox.svg" alt="Firefox" class="size-6"></a>
          <a href="https://t.me/GetPensiveBot" target="_blank" rel="noopener" class="flex size-11 items-center justify-center rounded-xl border border-line bg-canvas transition hover:border-line-strong hover:bg-paper" title="Telegram bot"><img src="/assets/icons/telegram.svg" alt="Telegram" class="size-6"></a>
        </div>
      </li>
      <li>
        <p class="font-mono text-sm text-accent">02 — Keep</p>
        <h3 class="mt-3 font-display text-2xl font-bold tracking-tight text-ink">The whole page</h3>
        <p class="mt-2 text-ink-muted">Full content capture, not just titles. Clean text, plus an optional AI summary and topic tags.</p>
        <div class="mt-5 flex flex-wrap gap-2 font-mono text-xs">
          <span class="rounded-md border border-line bg-canvas px-2 py-1 text-ink-muted">full text</span>
          <span class="rounded-md border border-line bg-canvas px-2 py-1 text-ink-muted">summary</span>
          <span class="rounded-md border border-line bg-canvas px-2 py-1 text-ink-muted">#tags</span>
        </div>
      </li>
      <li>
        <p class="font-mono text-sm text-accent">03 — Find</p>
        <h3 class="mt-3 font-display text-2xl font-bold tracking-tight text-ink">Every word, instantly</h3>
        <p class="mt-2 text-ink-muted">Search across everything you saved, or ask a question and get an answer with its sources.</p>
        <p class="mt-5 text-sm text-ink-muted">“…the <mark>exact phrase</mark> you half remember…”</p>
      </li>
    </ol>
  </div>
</section>

<!-- Beyond search -->
<section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8">
  <div class="grid gap-6 lg:grid-cols-2">
    <!-- Ask -->
    <div class="rounded-2xl border border-line bg-paper p-6 sm:p-8">
      <span class="badge badge-ai">Ask AI</span>
      <h2 class="headline-md mt-4 text-ink">Ask your library</h2>
      <p class="mt-2 text-ink-muted">Questions are answered from what <em>you</em> saved, with links back to the pages.</p>

      <div class="mt-6 space-y-3" aria-hidden="true">
        <p class="ml-auto w-fit max-w-[85%] rounded-2xl rounded-br-md bg-ink px-4 py-2.5 text-sm text-white">What have I read about digital gardens?</p>
        <div class="max-w-[92%] rounded-2xl rounded-bl-md border border-line bg-canvas px-4 py-3 text-sm text-ink-muted">
          You saved three pieces. Caulfield contrasts the <strong class="text-ink">garden</strong> with the <strong class="text-ink">stream</strong>; Appleton describes gardens as ideas that grow over time.
          <div class="mt-3 flex flex-wrap gap-1.5 font-mono text-[11px]">
            <span class="rounded-full border border-line bg-paper px-2.5 py-0.5">hapgood.us</span>
            <span class="rounded-full border border-line bg-paper px-2.5 py-0.5">maggieappleton.com</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Podcast -->
    <div class="rounded-2xl border border-line bg-paper p-6 sm:p-8">
      <span class="badge badge-ai">New feature</span>
      <h2 class="headline-md mt-4 text-ink">Your bookmarks, as a podcast</h2>
      <p class="mt-2 text-ink-muted">Get a weekly audio summary of your saved articles, delivered via email or Telegram on the day you choose.</p>

      <div class="mt-6 rounded-xl border border-line bg-canvas p-4 sm:p-5" aria-hidden="true">
        <div class="flex items-center gap-4">
          <span class="flex size-12 shrink-0 items-center justify-center rounded-full bg-accent text-white">
            <svg class="ml-0.5 h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5.14v13.72a1 1 0 001.52.85l10.4-6.86a1 1 0 000-1.7L9.52 4.29A1 1 0 008 5.14z"/></svg>
          </span>
          <div class="min-w-0">
            <p class="font-mono text-[11px] text-ink-faint">weekly briefing · 12:30</p>
            <p class="truncate font-semibold text-ink">Seven things you saved this week</p>
          </div>
        </div>
        <div class="waveform mt-5 h-10">
          <span style="--h:40%"></span><span style="--h:62%"></span><span style="--h:78%"></span><span style="--h:54%"></span><span style="--h:90%"></span><span style="--h:70%"></span><span style="--h:46%"></span><span style="--h:84%"></span><span style="--h:100%"></span><span style="--h:66%"></span><span style="--h:52%"></span><span style="--h:74%"></span><span style="--h:88%"></span><span style="--h:58%"></span><span style="--h:42%"></span><span style="--h:68%"></span><span style="--h:92%"></span><span style="--h:76%"></span><span style="--h:50%"></span><span style="--h:64%"></span><span style="--h:86%"></span><span style="--h:60%"></span><span style="--h:44%"></span><span style="--h:72%"></span><span style="--h:96%"></span><span style="--h:80%"></span><span style="--h:56%"></span><span style="--h:38%"></span><span style="--h:70%"></span><span style="--h:58%"></span><span style="--h:46%"></span><span style="--h:34%"></span>
        </div>
      </div>
    </div>
  </div>

  <!-- Demo video -->
  <div class="mt-6 overflow-hidden rounded-2xl border border-line bg-paper p-2">
    <div class="aspect-video overflow-hidden rounded-xl">
      <iframe class="h-full w-full" src="https://www.youtube.com/embed/N7tQpBjNMck" title="Pensive Demo" frameborder="0" loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
    </div>
  </div>
</section>

<!-- Why I built this: a ruled index card -->
<section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6 lg:px-8">
  <div class="grid items-start gap-10 lg:grid-cols-[1fr_1.4fr]">
    <div>
      <h2 class="headline text-ink">Why I built this</h2>
      <p class="mt-3 text-ink-muted">Your bookmarks shouldn't depend on a service that can change direction.</p>
      <ul class="mt-6 space-y-2 font-mono text-sm text-ink-muted">
        <li>→ Open source, audit the code</li>
        <li>→ Self-host with Docker</li>
        <li>→ Import and export anytime</li>
      </ul>
    </div>

    <article class="index-card rounded-xl border border-line px-6 pb-8 shadow-soft sm:px-10">
      <div class="flex h-[72px] items-center justify-between">
        <span class="font-mono text-xs text-ink-faint uppercase">No. 0001 · Pensive</span>
        <img src="/assets/promo/me.jpg" alt="Arash" class="size-10 rounded-full object-cover">
      </div>
      <div class="space-y-8 pt-1 text-[16px] text-ink">
        <p>
          Years ago I found Gordon Bell's <a class="link" href="https://en.wikipedia.org/wiki/MyLifeBits" target="_blank" rel="noopener">MyLifeBits</a> research project.
          The idea stuck: can we preserve what we read and make it searchable?
        </p>
        <p>
          I read and share a lot of links (Hacker News, blogs, docs). The good stuff gets lost in browser bookmarks and buried by SEO.
          Pocket was the closest fit for me for a while, until it shut down.
        </p>
        <p>
          So I built Pensive to solve this problem. Your bookmarks shouldn't depend on a service that can change direction.
          That's also why the code is <a class="link" href="https://github.com/arashthr/pensive" target="_blank" rel="noopener">open source</a> — run it yourself, fork it, or just trust that you can.
          Read the longer story <a class="link" href="https://arashtaher.com/blog/introducing-pensive/" target="_blank" rel="noopener">here</a>, or <a class="link" href="/contact">tell me</a> what you think.
        </p>
      </div>
    </article>
  </div>
</section>

<!-- Pricing -->
<section class="border-t border-line bg-paper">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8">
    <h2 class="headline text-ink">Simple, transparent pricing</h2>
    <p class="lede mt-2">Use the hosted service or run it yourself — it's open source.</p>

    <div class="mt-10 grid gap-4 md:grid-cols-3">
      <div class="flex flex-col rounded-2xl border border-line bg-canvas p-6 sm:p-8">
        <p class="font-mono text-xs text-ink-faint uppercase">Free</p>
        <p class="mt-3 font-display text-5xl font-bold tracking-tight text-ink">$0</p>
        <p class="mt-2 text-sm text-ink-muted">Try it out with generous daily limits.</p>
        <ul class="mt-6 flex-1 space-y-2.5 text-sm text-ink-muted">
          <li>All core features (capture, search, tags)</li>
          <li>Browser extension + Telegram saving</li>
          <li><strong class="text-ink">10</strong> bookmarks/day</li>
          <li><strong class="text-ink">1</strong> AI question/day</li>
        </ul>
        <a href="/signup" class="btn btn-secondary mt-8 w-full">Get started</a>
      </div>

      <div class="relative flex flex-col rounded-2xl border border-ink bg-paper p-6 shadow-lift sm:p-8">
        <svg class="absolute -top-1.5 right-6 h-10 w-6 text-accent" viewBox="0 0 18 32" fill="currentColor" aria-hidden="true"><path d="M0 0h18v30.5a.8.8 0 0 1-1.3.62L9 25l-7.7 6.12A.8.8 0 0 1 0 30.5z"/></svg>
        <p class="font-mono text-xs text-accent uppercase">Premium</p>
        <p class="mt-3 font-display text-5xl font-bold tracking-tight text-ink">$5<span class="font-sans text-base font-normal tracking-normal text-ink-muted"> / month</span></p>
        <p class="mt-2 text-sm text-ink-muted">More headroom for daily saving and AI.</p>
        <ul class="mt-6 flex-1 space-y-2.5 text-sm text-ink-muted">
          <li>Everything in Free</li>
          <li><strong class="text-ink">100</strong> bookmarks/day</li>
          <li><strong class="text-ink">10</strong> AI questions/day</li>
          <li>AI summaries and smart tags</li>
          <li>Support ongoing development</li>
        </ul>
        <a href="/users/subscribe" class="btn btn-primary mt-8 w-full">Upgrade</a>
      </div>

      <div class="flex flex-col rounded-2xl border border-line bg-canvas p-6 sm:p-8">
        <p class="font-mono text-xs text-ink-faint uppercase">Self-hosted</p>
        <p class="mt-3 font-display text-5xl font-bold tracking-tight text-ink">Free</p>
        <p class="mt-2 text-sm text-ink-muted">Run it on your own server, full control.</p>
        <ul class="mt-6 flex-1 space-y-2.5 text-sm text-ink-muted">
          <li>All features unlocked</li>
          <li>Your infrastructure, your data</li>
          <li>Docker Compose deploy</li>
          <li>MIT licensed</li>
        </ul>
        <a href="https://github.com/arashthr/pensive" target="_blank" rel="noopener" class="btn btn-secondary mt-8 w-full">View on GitHub</a>
      </div>
    </div>
  </div>
</section>

<!-- Final CTA -->
<section class="mx-auto max-w-6xl px-4 pt-20 sm:px-6 lg:px-8">
  <div class="rounded-3xl bg-ink-deep px-6 py-16 text-center sm:px-10 sm:py-20">
    <h2 class="mx-auto max-w-3xl font-display text-4xl leading-tight font-bold tracking-[-0.035em] text-white sm:text-5xl">
      Ready to build your searchable <span class="rounded-md bg-highlight px-2 text-ink-deep">memory</span> of the web?
    </h2>
    <p class="mt-4 text-white/70">Use the hosted version for free, or self-host the open source code.</p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <a href="/signup" class="btn btn-primary">Sign up for free</a>
      <a href="https://github.com/arashthr/pensive" target="_blank" rel="noopener" class="btn border-white/20 text-white hover:bg-white/10">Star on GitHub</a>
    </div>
  </div>
</section>

{{template "footer" .}}
