{{template "header" .}}

<div class="page-auth">
  <div class="card-raised p-6 sm:p-8">
    <h1 class="headline-md mb-7 text-center text-ink">Reset your password</h1>

    <form action="/reset-password" method="post" class="space-y-4">

      {{if .Token}}
        <input type="hidden" name="token" value="{{.Token}}" />
      {{else}}
        <div>
          <label class="label" for="token">Reset token</label>
          <input class="input" name="token" id="token" type="text" placeholder="Paste your reset token" required autofocus />
        </div>
      {{end}}

      <div>
        <label class="label" for="password">New password</label>
        <input class="input" name="password" id="password" type="password" placeholder="At least 8 characters" required autocomplete="new-password" {{if .Token}}autofocus{{end}} />
      </div>

      <button type="submit" class="btn btn-primary w-full">Update password</button>
    </form>

    <div class="mt-6 flex justify-between text-sm">
      <a class="text-ink-muted hover:text-accent" href="/signup">Need an account?</a>
      <a class="text-ink-muted hover:text-accent" href="/signin">Back to sign in</a>
    </div>
  </div>
</div>

{{template "footer" .}}
